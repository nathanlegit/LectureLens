# Required
ANTHROPIC_API_KEY=
# Where SQLite and media live (Railway: /data)
DATA_DIR=./data
PORT=8787
# local = whisper.cpp on this machine, groq = hosted Whisper API
TRANSCRIBER=local
WHISPER_CLI=whisper-cli
WHISPER_MODEL_PATH=./models/ggml-large-v3-turbo.bin
WHISPER_VAD_MODEL_PATH=./models/ggml-silero-v5.1.2.bin
GROQ_API_KEY=
# Guards for the public deployment
UPLOAD_PASSCODE=change-me
DAILY_SPEND_CAP_USD=5
# claude-sonnet-5-5 (default, ~$0.70 per lecture) or claude-haiku-5-5 (~$0.03, misreads boards more)
FRAMES_MODEL=claude-sonnet-5-5
# Largest accepted recording in MB (use 1024 on a 5 GB volume)
MAX_UPLOAD_MB=2048
